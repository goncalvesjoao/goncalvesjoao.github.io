---
interface Props {
	id: string;
	title: string;
	class?: string;
	eyebrow?: string;
}

const { id, title, eyebrow, class: className } = Astro.props;
---

<section id={id} class={`${className ?? "mb-5"}`} aria-labelledby={id + "-heading"}>
	<hgroup>
		{eyebrow && (
			<mark>{eyebrow}</mark>
		)}

		<h2 class="fs-1" id={id + "-heading"}>{title}</h2>
	</hgroup>

	<slot />
</section>
