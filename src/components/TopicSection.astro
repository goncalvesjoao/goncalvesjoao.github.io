---
interface Props {
	id: string;
	title: string;
	eyebrow?: string;
}

const { id, title, eyebrow } = Astro.props;
---

<section id={id} class="mb-5" aria-labelledby={id + "-heading"}>
	{eyebrow && (
		<p class="eyebrow mb-2 text-primary fw-bold text-uppercase">{eyebrow}</p>
	)}

	<h2 class="mt-0 fs-1" id={id + "-heading"}>{title}</h2>

	<slot />
</section>

<style>
  .eyebrow {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
  }
</style>
