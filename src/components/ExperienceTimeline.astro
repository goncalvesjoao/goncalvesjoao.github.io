---
import TopicSection from "./TopicSection.astro";

interface ExperienceEntry {
  role: string;
  company: string;
  period: string;
  location: string;
  industry: string;
  context: string;
  stack?: string;
  stackLabel?: string;
  outcome?: string;
  bullets: string[];
}

interface Props {
  experience: ExperienceEntry[];
}

const { experience } = Astro.props;
---

<TopicSection id="experience" title="Experience" eyebrow="Career" class="mb-0" />

<ol class="breakout timeline position-relative mb-5 ps-0">
  {
    experience.map(({ role, company, period, location, industry, context, stack, stackLabel, outcome, bullets }) => (
      <li class="position-relative border-start m-0 py-3 ps-3 pb-4">
        <div
          class="position-absolute text-muted text-end d-flex flex-column gap-2"
          data-timeplace
        >
          <small>{period}</small>
          <small>{location}</small>
        </div>

        <hgroup>
          <h3 class="fs-4">{company}</h3>
          <p class="mt-1 text-primary fw-semibold">{role}</p>
        </hgroup>

        <p class="mb-2"><strong>Domain:</strong> {industry}</p>
        <p class="mb-3"><strong>Context:</strong> {context}</p>
        {stack && <p class="mb-3"><strong>{stackLabel ?? "Tech stack"}:</strong> {stack}</p>}
        {outcome && <p class="mb-3"><strong>Outcome:</strong> {outcome}</p>}
        <h4 class="fs-6 mb-2">Key contributions:</h4>
        <ul class="mb-0">
          {bullets.map((bullet) => (
            <li>{bullet}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>

<style>
  [data-timeplace] {
    width: 135px;
    left: -147px;
		padding-top: 2px;
  }

  ol.timeline {
		margin-left: 147px;
		list-style: none;

    > li {
      &::before {
				position: absolute;
				top: calc(var(--h4-font-size));
				left: -0.4rem;
				width: 0.8rem;
				aspect-ratio: 1;
				border: 2px solid var(--background-color);
				border-radius: 70%;
				background: var(--primary-color);
				content: "";
			}
    }
  }

  @media screen and (max-width: 575px) {
    ol.timeline {
      margin-left: 0;
    }

    [data-timeplace] {
      position: static !important;
      width: auto;
      text-align: left !important;
      gap: 0 !important;
      margin-bottom: 0.75rem;
    }
  }

  @media print {
    ol.timeline {
		  margin-left: 130px;
      > li {
        break-inside: avoid;

        &::before {
          print-color-adjust: exact;
        }
      }
    }
  }
</style>
