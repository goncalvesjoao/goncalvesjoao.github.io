---
import Layout from "@/layouts/Layout.astro";
import TopicSection from "@/components/TopicSection.astro";
import ExperienceTimeline from "@/components/ExperienceTimeline.astro";

import {
  title,
  name,
  tagline,
  description,
  location,
  contacts,
  profile,
  languages,
  interests,
  education,
  skills,
  projects,
  experience,
} from "./index-data.json";
---

<Layout title={title} description={description}>
  <header class="full-width d-print-none pane hero py-5" data-theme="dark">
    <div
      class="breakout d-flex flex-column flex-md-row align-items-start align-items-md-end justify-content-between"
    >
      <h1 class="mb-0 text-contrast">{name}</h1>

      <nav class="d-print-none" aria-label="Contact links">
        <ul class="align-items-start align-items-md-end">
          <li class="text-muted">{location}</li>
          {
            contacts.map(({ name, url }) => (
              <li>
                <a class="text-reset" href={url} target="_blank">
                  {name} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </header>

  <main class="full-width py-5">
    <section class="summary mb-5">
      <h2 class="fs-1">
        <span class="d-none d-print-block">{name}</span>
        <span class="d-block d-print-none">{profile.tagline}</span>
      </h2>
      <p>{profile.description}</p>
    </section>

    <ExperienceTimeline experience={experience} />

		<TopicSection id="skills" title="Technical Skills">
      <dl class="m-0">
        {
          skills.map(({ category, details }, index) => (
            <>
              <dt class={index === 0 ? "fw-bold" : "mt-4 fw-bold"}>
                {category}
              </dt>
              <dd class="m-0">{details}</dd>
            </>
          ))
        }
      </dl>
    </TopicSection>

		<TopicSection id="projects" title="Open Source Projects">
      <ul>
        {
          projects.map(({ name, url, details }) => (
            <li class="m-0">
              <h3 class="fs-4 mb-1">
                {url ? (
                  <a href={url} target="_blank">
                    {name} <span aria-hidden="true">↗</span>
                  </a>
                ) : name}
              </h3>
              <p>{details}</p>
            </li>
          ))
        }
      </ul>
    </TopicSection>

    <TopicSection id="education" title="Education">
      {
        education.map(({ institution, location, courses }) => (
          <div class="mb-4">
            <hgroup>
              <h3 class="fs-4">{institution}</h3>
              <p>{location}</p>
            </hgroup>
            <ul>
              {courses.map(({ name, period }) => (
                <li>
                  {name}, {period}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </TopicSection>

    <TopicSection id="languages" title="Languages">
      <ul>
        {
          languages.map(({ name, level }) => (
            <li>
              <strong>{name}</strong> — {level}
            </li>
          ))
        }
      </ul>
    </TopicSection>

    <TopicSection id="interests" title="Interests">
      <p>{interests.join(", ")}.</p>
    </TopicSection>
  </main>

  <footer class="full-width pane border-start-0 border-end-0 d-print-none">
    <nav
      class="breakout d-flex flex-column flex-sm-row align-items-start justify-content-between gap-2"
      aria-label="Footer"
    >
      <p class="m-0"><strong>{name}</strong> · {location}</p>
      <p class="m-0">
        Built with <a href="https://astro.build/" target="_blank">Astro</a> and <a href="https://semanticus.design/" target="_blank">Semanticus CSS</a>.
      </p>
    </nav>
  </footer>
</Layout>

<style>
  .hero {
    --pane-background-color: linear-gradient(
      135deg,
      #101827 0%,
      #17233a 55%,
      #0d3a4b 100%
    );

    h1 {
      font-size: clamp(2.5rem, 8vw, 5rem);
      letter-spacing: -0.055em;
      line-height: 4.2rem;
    }
  }

  .summary > p:last-child {
    font-size: 1.08rem;
    line-height: 1.7;
    margin-bottom: 0;
  }

  @media print {
    :global(:root) {
      --spacing: 0.55rem;
    }

    :global(body) {
      font-size: 0.9rem;
      line-height: 1.45;
    }

    :global(h2) {
      font-size: 1.6rem !important;
      line-height: 1.2;
    }

    :global(h3) {
      font-size: 1.15rem !important;
      line-height: 1.25;
    }

    header {
      padding-block: 0.75rem !important;
    }

    .hero h1 {
      font-size: 2.5rem;
      line-height: 1.1;
    }

    .summary > p:last-child {
      font-size: 0.95rem;
      line-height: 1.45;
    }

    main.full-width {
      display: block;
      max-width: var(--content-grid-content-max-width);
      margin-inline: auto;
      padding: 0 !important;
    }
  }
</style>
